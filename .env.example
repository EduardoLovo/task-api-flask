# Copie para .env e ajuste os valores.

# development (reload automático) | production (waitress) | test
APP_ENV=development
PORT=5000

# Arquivo SQLite (criado automaticamente). Use :memory: para banco temporário.
DATABASE_PATH=./data/database.sqlite

# Obrigatório, mínimo 32 caracteres. Gere um com:
# uv run python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Formato <número><s|m|h|d>
JWT_EXPIRES_IN=1h

BCRYPT_ROUNDS=10

CORS_ORIGIN=*
BODY_LIMIT=100kb

# Janela do rate limit em ms (15 min) e máximo de requisições por IP nela.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Limite mais restrito para /auth/register e /auth/login.
AUTH_RATE_LIMIT_MAX=10

# Quantos proxies ficam na frente da API (ex.: o load balancer do Render).
# 0 = acesso direto. Um número maior que o real deixa o cliente forjar o IP.
TRUST_PROXY=0
